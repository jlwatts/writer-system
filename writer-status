#!/usr/bin/env bash
SYSTEM_DIR="$(dirname "$(readlink -f "$0")")"
cd "$SYSTEM_DIR"

echo "=== Writer System Status ==="
docker compose ps

echo ""
echo "Studio:    http://127.0.0.1:8000"
echo "Syncthing: http://127.0.0.1:8384"

if docker ps --filter "name=signal_gateway" --filter "status=running" --format '{{.Names}}' 2>/dev/null | grep -q .; then
    echo "Signal:    optional gateway is running on http://127.0.0.1:8080 (not part of writer-start)"
fi

echo ""
echo "=== Tailing App Logs (Ctrl+C to exit) ==="
docker compose logs -f --tail=50 writer-app
